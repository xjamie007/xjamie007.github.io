---
/**
 * „Über uns" und die Etappen — ein Block.
 *
 * Die beiden gehören zusammen: erst wer der Betrieb ist, dann wie er dahin
 * gekommen ist. Deshalb ein gemeinsamer Grund und eine gemeinsame Überschrift,
 * mit den Jahreszahlen als Unterkapitel, statt zwei Sektionen, die dasselbe
 * Thema zweimal anfangen.
 *
 * Die Linie füllt sich beim Scrollen (`animation-timeline: view()`), ohne
 * Scroll-Listener und ohne JavaScript. Wo der Browser das nicht kann, steht
 * sie fertig da.
 */
import Section from '../Section.astro';
import Photo from '../Photo.astro';
import { history } from '../../data/history';
import { t } from '../../i18n';
import { anchors, path, type Locale } from '../../i18n/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<Section id={anchors.history} wide labelledby="about-h2" class="band--tint">
  <div class="ab reveal">
    <div class="ab__text">
      <h2 id="about-h2" class="t-h2">{t(locale, 'about.heading')}</h2>
      <p class="t-body ab__body">{t(locale, 'about.body')}</p>
      <p class="ab__more">
        <a class="link" href={path('history', locale)}>{t(locale, 'common.readMore')}</a>
      </p>
    </div>
    <Photo locale={locale} name="worker" sizes="(min-width: 52rem) 26rem, 92vw" class="ab__photo" />
  </div>

  <h3 class="t-label ab__sub">{t(locale, 'about.timeline')}</h3>

  <ol class="hs">
    <span class="hs__fill" aria-hidden="true"></span>
    {history.map((h) => (
      <li class="hs__item reveal">
        <span class="hs__dot" aria-hidden="true"></span>
        <span class="t-num hs__year">{h.year}</span>
        <span class="hs__label">{t(locale, `history.short.${h.id}`)}</span>
      </li>
    ))}
  </ol>
</Section>

<style>
  .ab { display: grid; gap: 2rem; align-items: center; }
  @media (width >= 52rem) { .ab { grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); gap: 4rem; } }

  .ab__body { margin-block-start: 1rem; }
  .ab__more { margin-block-start: 1.25rem; }
  .ab__photo :global(img) {
    inline-size: 100%;
    block-size: auto;
    display: block;
    border-radius: 3px;
  }

  .ab__sub {
    margin-block-start: 3.5rem;
    color: var(--band-tech);
    display: block;
  }

  /* ── Etappen ───────────────────────────────────────────────────────────
     Waagerecht nur dort, wo alle acht in EINE Reihe passen (ab 64 rem).
     Darunter senkrecht. Vorher lief das Band über zwei oder vier Spalten und
     die Linie lag nur über der ersten Reihe — alle weiteren Punkte hingen
     ohne Linie in der Luft. */
  .hs {
    position: relative;
    margin-block-start: 2rem;
    display: grid;
  }

  /* — senkrecht (Vorgabe) — */
  .hs { padding-inline-start: 2.25rem; gap: 0; }
  .hs::before,
  .hs__fill {
    content: '';
    position: absolute;
    inset-block: 0.75rem 1.5rem;
    inset-inline-start: 0.4rem;
    inline-size: 2px;
  }
  .hs::before { background: var(--band-line); }
  .hs__fill { background: var(--color-blue); transform-origin: top; scale: 1 1; }
  @supports (animation-timeline: view()) {
    .hs__fill { scale: 1 0; animation: hs-grow-y linear both; animation-timeline: view(); animation-range: cover 15% cover 72%; }
  }
  @keyframes hs-grow-y { to { scale: 1 1; } }

  .hs__item { position: relative; display: grid; gap: 0.15rem; padding-block: 0.85rem; }
  .hs__dot {
    position: absolute;
    inset-block-start: 1.15rem;
    inset-inline-start: -2.1rem;
    inline-size: 0.7rem;
    block-size: 0.7rem;
    border-radius: 50%;
    background: var(--band-bg);
    border: 2px solid var(--color-blue);
    transition: background-color 200ms linear, transform 220ms cubic-bezier(0.22, 0.8, 0.3, 1);
  }

  @media (width >= 40rem) {
    .hs__item { grid-template-columns: 8rem minmax(0, 1fr); align-items: baseline; gap: 0 1.5rem; }
  }

  /* — waagerecht, sobald acht Spalten nebeneinander passen — */
  @media (width >= 64rem) {
    .hs {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 1.5rem 1rem;
      padding-inline-start: 0;
      padding-block-start: 1.75rem;
    }
    .hs::before,
    .hs__fill {
      inset-block: 0 auto;
      inset-inline: 0.4rem;
      inline-size: auto;
      block-size: 2px;
    }
    .hs__fill { transform-origin: left; }
    @supports (animation-timeline: view()) {
      .hs__fill { scale: 0 1; animation-name: hs-grow-x; animation-range: cover 22% cover 68%; }
    }
    .hs__item { grid-template-columns: none; padding-block: 0; gap: 0.2rem; }
    .hs__dot { inset-block-start: -2.1rem; inset-inline-start: 0; }
  }
  @keyframes hs-grow-x { to { scale: 1 1; } }

  .hs__year {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-blue-deep);
    white-space: nowrap;
    transition: color 200ms linear;
  }
  .hs__label { font-size: 0.9375rem; line-height: 1.4; color: var(--band-muted); }

  @media (hover: hover) {
    .hs__item:hover .hs__dot { background: var(--color-blue); transform: scale(1.3); }
    .hs__item:hover .hs__label { color: var(--band-fg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs__fill { animation: none; scale: 1 1; }
    .hs__dot, .hs__year, .hs__label { transition: none; }
  }
</style>
