---
/**
 * Kopf.
 *
 * Am Handy eine Leiste, die sich ausklappt: sechs Links und vier Sprachen
 * gleichzeitig auf dem Schirm waren zu viel und machten den Kopf höher als das
 * halbe Bild. Ab 60 rem steht alles wieder nebeneinander.
 *
 * Die Klapp-Fassung ist ein `<details>` — ohne JavaScript, mit Tastatur, ohne
 * Fokus-Falle, die man beim Nachbauen fast immer falsch macht. Ein Klick auf
 * einen Link lädt die nächste Seite, und dort ist das Menü wieder zu; es
 * braucht also auch kein Schließen von Hand.
 *
 * Die Liste steht zweimal im Markup, für Handy und Desktop. Immer nur eine ist
 * per `display: none` da — die andere ist auch für Screenreader weg. Eine
 * einzige `<details>`-Fassung, die am Desktop offen gehalten wird, geht mit den
 * heutigen Browsern nicht mehr zuverlässig: sie verstecken den Inhalt über
 * `content-visibility`, nicht über `display`.
 */
import Logo from './Logo.astro';
import LangSwitcher from './LangSwitcher.astro';
import { t } from '../i18n';
import { path, type Locale, type RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  route: RouteKey;
}
const { locale, route } = Astro.props;

const links: { key: RouteKey; label: string }[] = [
  { key: 'pallets', label: t(locale, 'nav.pallets') },
  { key: 'crates', label: t(locale, 'nav.crates') },
  { key: 'repair', label: t(locale, 'nav.repair') },
  { key: 'ispm15', label: t(locale, 'nav.stamp') },
  { key: 'delivery', label: t(locale, 'nav.delivery') },
  { key: 'contact', label: t(locale, 'nav.contact') },
];
---

<header class="masthead">
  <div class="shell masthead__grid">
    <a class="masthead__home logo-slot" href={path('home', locale)}>
      <Logo title={false} variant="wordmark" />
      <span class="sr-only">Emballages en Bois Kasel — {t(locale, 'common.backHome')}</span>
    </a>

    <!-- Handy: ausklappbare Leiste -->
    <details class="mnav">
      <summary class="mnav__bar">
        <span>{t(locale, 'nav.open')}</span>
      </summary>
      <nav class="mnav__panel" aria-label={t(locale, 'nav.label')}>
        <ul class="mnav__list">
          {links.map((l) => (
            <li>
              <a href={path(l.key, locale)} class="mnav__link" aria-current={l.key === route ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mnav__langs">
          <span class="t-label mnav__langsHead">{t(locale, 'nav.langShort')}</span>
          <LangSwitcher locale={locale} route={route} />
        </div>
      </nav>
    </details>

    <!-- Ab 60 rem: alles nebeneinander -->
    <div class="dnav">
      <nav aria-label={t(locale, 'nav.label')}>
        <ul class="dnav__list">
          {links.map((l) => (
            <li>
              <a href={path(l.key, locale)} class="dnav__link" aria-current={l.key === route ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <LangSwitcher locale={locale} route={route} />
    </div>
  </div>
</header>

<style>
  .masthead {
    background: var(--color-paper);
    color: var(--color-ink);
    --band-fg: var(--color-ink);
    --band-bg: var(--color-paper);
    --band-line: var(--color-line);
    border-block-end: 1px solid var(--band-line);
  }

  /* Am Handy eine Spalte: Logo in Zeile 1, das Klapp-Panel in Zeile 2 über die
     volle Breite. Die Leiste selbst wird neben das Logo gepinnt — sonst säße
     das Panel in der rechten Spalte und begänne erst neben dem Logo. */
  .masthead__grid {
    position: relative;
    padding-block: 0.85rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 0;
  }

  .masthead__home { text-decoration: none; block-size: 3rem; }

  /* ── Handy ────────────────────────────────────────────────────────────── */
  .mnav__bar {
    position: absolute;
    inset-block-start: 0.85rem;
    inset-inline-end: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-block-size: 2.75rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 3px;
    font-family: var(--font-mark);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    list-style: none;
    transition: border-color 180ms linear, color 180ms linear;
  }
  .mnav__bar::-webkit-details-marker { display: none; }
  .mnav__bar::after {
    content: '';
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: rotate(45deg) translate(-0.08rem, -0.08rem);
    transition: transform 220ms cubic-bezier(0.22, 0.8, 0.3, 1);
  }
  .mnav[open] .mnav__bar { border-color: var(--color-blue); color: var(--color-blue-deep); }
  .mnav[open] .mnav__bar::after { transform: rotate(-135deg) translate(-0.12rem, -0.12rem); }

  .mnav__panel {
    margin-block-start: 1rem;
    animation: mnav-open 220ms cubic-bezier(0.22, 0.8, 0.3, 1) both;
  }
  @keyframes mnav-open {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }

  .mnav__list { border-block-start: 1px solid var(--band-line); }
  .mnav__link {
    display: flex;
    align-items: center;
    min-block-size: 3.25rem;
    padding-inline: 0.25rem;
    border-block-end: 1px solid var(--band-line);
    border-inline-start: 3px solid transparent;
    font-family: var(--font-mark);
    font-weight: 600;
    font-size: 1.0625rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms linear, color 160ms linear, padding-inline-start 180ms ease-out;
  }
  .mnav__link[aria-current='page'] { border-inline-start-color: var(--color-blue); padding-inline-start: 0.85rem; }
  .mnav__link:hover, .mnav__link:focus-visible { color: var(--color-blue-deep); border-inline-start-color: var(--color-blue); padding-inline-start: 0.85rem; }

  .mnav__langs { margin-block-start: 1.25rem; }
  .mnav__langsHead { display: block; color: var(--color-grey); margin-block-end: 0.5rem; }

  .dnav { display: none; }

  /* ── Ab 60 rem ────────────────────────────────────────────────────────── */
  @media (width >= 60rem) {
    .masthead__grid {
      padding-block: 1rem;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2rem;
    }
    .masthead__home { block-size: 3.75rem; }
    .mnav { display: none; }
    .dnav {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 0.75rem 1.75rem;
    }
    .dnav__list { display: flex; flex-wrap: wrap; gap: 0.25rem 1.75rem; }
    .dnav__link {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      font-family: var(--font-mark);
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
      color: inherit;
      border-block-end: 2px solid transparent;
      transition: color 160ms linear, border-color 160ms linear;
    }
    .dnav__link:hover { color: var(--color-blue-deep); border-block-end-color: var(--color-blue); }
    .dnav__link[aria-current='page'] { border-block-end-color: var(--color-blue); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mnav__bar, .mnav__bar::after, .mnav__link, .dnav__link { transition: none; }
    .mnav__panel { animation: none; }
  }
</style>
