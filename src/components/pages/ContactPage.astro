---
import Section from '../Section.astro';
import RailItem from '../RailItem.astro';
import Breadcrumb from '../Breadcrumb.astro';
import MapBlock from '../MapBlock.astro';
import OpeningHours from '../OpeningHours.astro';
import InquiryForm from '../InquiryForm.astro';
import { company } from '../../data/company';
import { t } from '../../i18n';
import { path, type Locale } from '../../i18n/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<Section class="band--sky" labelledby="con-h1">
  <Fragment slot="rail">
    <RailItem term={t(locale, 'common.phone')} value={company.phoneDisplay} />
    <RailItem term={t(locale, 'rail.reply')} value={company.email} numeric={false} />
  </Fragment>

  <Breadcrumb locale={locale} label={t(locale, 'contact.h1')} />
  <h1 id="con-h1" class="t-h1 pg__h1">{t(locale, 'contact.h1')}</h1>
  <p class="t-body pg__lead">{t(locale, 'contact.lead')}</p>

  <div class="con">
    <div class="con__col reveal">
      <div class="panel panel--accent con__card">
        <h2 class="t-label con__cardHead">{t(locale, 'contact.directHeading')}</h2>
        <dl class="con__data">
          <div class="con__row con__row--lead">
            <dt class="t-label">{t(locale, 'common.phone')}</dt>
            <dd><a class="link con__big" href={`tel:${company.phoneE164}`}>{company.phoneDisplay}</a></dd>
          </div>
          {company.phoneSecondary.publish && (
            <div class="con__row">
              <dt class="t-label">{t(locale, 'common.phone')}</dt>
              <dd><a class="link" href={`tel:${company.phoneSecondary.e164}`}>{company.phoneSecondary.display}</a></dd>
            </div>
          )}
          <div class="con__row">
            <dt class="t-label">{t(locale, 'common.email')}</dt>
            <dd><a class="link" href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div class="con__row">
            <dt class="t-label">{t(locale, 'common.fax')}</dt>
            <dd class="t-num">{company.faxDisplay}</dd>
          </div>
        </dl>
        <OpeningHours locale={locale} />
      </div>

      <!-- Der Hinweis nennt die Seite schon im Satz; der Link darunter wieder-
           holte den Namen ein zweites Mal. Jetzt trägt ihn nur noch der Pfeil. -->
      <aside class="con__driver reveal">
        <p class="t-caption">{t(locale, 'contact.driverHint')}</p>
        <a class="arrow" href={path('delivery', locale)}>
          <span>{t(locale, 'delivery.heading')}</span>
          <svg viewBox="0 0 24 16" aria-hidden="true" focusable="false"><path d="M0 8h21M15 1l7 7-7 7" /></svg>
        </a>
      </aside>
    </div>

    <div class="con__col reveal">
      <div class="panel con__map"><MapBlock locale={locale} headingLevel="h2" /></div>
    </div>
  </div>
</Section>

<Section tone="dark" labelledby="con-form">
  <Fragment slot="rail">
    <RailItem term={t(locale, 'rail.inquiry')} value="5" note={t(locale, 'common.required')} />
  </Fragment>
  <span id="con-form" class="sr-only">{t(locale, 'form.heading')}</span>
  <InquiryForm locale={locale} id="ufro-anchor" />
</Section>

<style>
  .pg__h1 { margin-block-start: 1rem; }
  .pg__lead { margin-block-start: 1rem; }
  .con { margin-block-start: 2.5rem; display: grid; gap: 1.75rem; align-items: start; }
  @media (width >= 52rem) { .con { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 2rem; } }

  .con__cardHead { display: block; color: var(--band-tech); }
  .con__data { margin-block-start: 1rem; display: grid; }
  /* Zeilen statt loser Absätze: eine Zeile je Weg, durch feine Linien
     getrennt — so liest man die Spalte von oben nach unten ab. */
  .con__row { display: grid; gap: 0.15rem; padding-block: 0.85rem; border-block-start: 1px solid var(--color-line); }
  .con__row:first-child { border-block-start: 0; padding-block-start: 0; }
  .con__row dt { color: var(--band-tech); }
  .con__row dd { font-size: 1.0625rem; }
  .con__big { font-family: var(--font-mark); font-weight: 600; font-size: 1.6rem; line-height: 1.1; }

  .con__driver {
    margin-block-start: 1.25rem;
    padding: 1.1rem 1.25rem;
    background: color-mix(in srgb, var(--color-blue) 8%, var(--color-paper));
    border-inline-start: 3px solid var(--color-blue);
    border-radius: 0 4px 4px 0;
  }
  .con__driver .arrow { margin-block-start: 0.6rem; }
  .con__map { padding: 1.25rem; }
  @media (width >= 40rem) { .con__map { padding: 1.5rem; } }
</style>
