---
/**
 * Kapp vun all Säit: Meta, Canonical, hreflang, Open Graph, JSON-LD.
 *
 * D'Schrëfte ginn als Datei aus dem Projet gelueden, NI iwwer d'Google-CDN —
 * dat géif d'IP vum Besucher an d'USA iwwerdroen an ass an der EU ofgemahnt
 * ginn. Déi zwee Latin-Fichieren ginn virgelueden, well se de Text uewen um
 * Bildschierm droen; d'Latin-Ext-Fichieren eréischt bei Bedarf.
 */
import { alternates, absolute, isNoindex } from '../lib/seo';
import { t } from '../i18n';
import { htmlLang, path, type Locale, type RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  route: RouteKey;
  jsonld?: string;
}
const { locale, route, jsonld } = Astro.props;

const title = t(locale, `meta.${route}.title`);
const description = t(locale, `meta.${route}.description`);
const canonical = absolute(Astro.site, path(route, locale));
const alts = alternates(Astro.site, route);
const noindex = isNoindex(route);
const ogImage = absolute(Astro.site, `/img/og-${locale}.jpg`);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Direkt hinter Zeichensatz und Viewport, aber vor dem Stylesheet: nur mit
     Skript wird Inhalt überhaupt erst versteckt und dann hereingeholt. Ohne
     Skript steht alles sofort da. -->
<script is:inline>document.documentElement.classList.add('js');</script>
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Schrëften: selwer gehost, virgelueden, mat `crossorigin` well Schrëften
     ëmmer am CORS-Modus gelueden ginn. -->
<link rel="preload" href="/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#1C2126" />
<meta name="color-scheme" content="light" />

<meta property="og:type" content="website" />
<meta property="og:locale" content={htmlLang[locale]} />
<meta property="og:site_name" content="KASEL" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t(locale, 'hero.stampAlt')} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonld && <script type="application/ld+json" is:inline set:html={jsonld} />}
