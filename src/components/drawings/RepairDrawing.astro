---
/**
 * Reparatur: eng Palette, bei där ee Deckbriet erausgeholl an ersat gëtt —
 * an dernieft de Stempel, dee no der Reparatur nei drop muss.
 *
 * Dat ass de ganze Verkafsargument an engem Bild: nei Brieder kann all Betrib
 * androen; nei stemplen dierf nëmmen een, deen eng Registréierungsnummer huet.
 */
interface Props { label: string }
const { label } = Astro.props;
const uid = `rep-${Math.random().toString(36).slice(2, 8)}`;
const PAPER = 'fill: var(--band-bg, #FFFFFF)';

const X0 = 10, X1 = 250, Y0 = 34, Y1 = 194;
const keep = [
  { x: 10, w: 26 }, { x: 68, w: 20 }, { x: 172, w: 20 }, { x: 224, w: 26 },
];
const OLD = { x: 120, w: 20 };
const LIFT = 24;
const runnerY = [34, 103, 172];
const blockX = [10, 117, 224];
const RUN_H = 22;
---

<svg viewBox="0 0 330 224" role="img" aria-labelledby={`${uid}-t`} focusable="false" xmlns="http://www.w3.org/2000/svg">
  <title id={`${uid}-t`}>{label}</title>

  <g fill="none" stroke="currentColor" stroke-linejoin="round">
    <g stroke-width="1.1" opacity="0.7">
      {runnerY.map((y) => <rect x={X0} y={y} width={X1 - X0} height={RUN_H} />)}
    </g>
    <g stroke-width="1.1" stroke-dasharray="4 3" opacity="0.85">
      {blockX.map((x) => runnerY.map((y) => <rect x={x} y={y} width="26" height={RUN_H} />))}
    </g>

    <g stroke-width="1.6">
      {keep.map((b) => <rect x={b.x} y={Y0} width={b.w} height={Y1 - Y0} style={PAPER} />)}
    </g>

    <!-- Wou dat al Briet souz -->
    <rect x={OLD.x} y={Y0} width={OLD.w} height={Y1 - Y0} stroke-dasharray="5 4" stroke-width="1.2" opacity="0.6" />
    <!-- Dat nei Briet, ugehuewen -->
    <rect x={OLD.x} y={Y0 - LIFT} width={OLD.w} height={Y1 - Y0} stroke-width="2.4" style={PAPER} />
  </g>

  <!-- De Stempel, dee no der Reparatur nei drop muss -->
  <g transform="translate(268 98)" fill="none" stroke="currentColor" stroke-width="1.5">
    <rect x="0" y="0" width="46" height="28" rx="2.5" style={PAPER} />
    <line x1="16" y1="0" x2="16" y2="28" />
    <path d="M8 23.5V7" stroke-linecap="round" />
    <path d="M8 19.5 4 17.5M8 19.5 12 17.5M8 14.5 4 12.5M8 14.5 12 12.5M8 10 4.5 8M8 10 11.5 8" stroke-width="1.1" stroke-linecap="round" />
    <g stroke-width="2.6" stroke-linecap="round">
      <line x1="22" y1="10.5" x2="40" y2="10.5" />
      <line x1="22" y1="18.5" x2="31" y2="18.5" />
    </g>
  </g>
</svg>
