---
/**
 * Den IPPC-Stempel als SVG.
 *
 * Kee Stockfoto, keng Bilddatei: de Stempel IS d'Bild vun dëser Säit, an e muss
 * esou grouss stoen, datt een déi eenzel Felder liest. Dofir gëtt hie
 * gezeechent, net fotograféiert — an dofir skaléiert hie vun 9 rem bis op
 * 40 px ouni Qualitéitsverloscht.
 *
 * Opbau no der Norm: IPPC-Symbol (styliséiert Weessähre) · Trennstréch ·
 * ISO-Länercode · Registréierungsnummer · Behandlungscode.
 * Faarwen: keng. De Stempel iwwerhëlt `currentColor` — rout an orange kommen
 * op dëser Säit net vir, an dat ass genee d'Virschrëft, no där gestempelt gëtt.
 */
import { ispm15 } from '../data/company';

interface Props {
  /** Zougänglechen Numm. Leift `role="img"`. */
  label: string;
  /** `false` = reng dekorativ, gëtt fir Screenreader verstoppt. */
  labelled?: boolean;
  country?: string;
  number?: string;
  treatmentCode?: string;
  /** Strichstäerkt — bei klenge Gréissten dicker, soss gëtt et ze fein. */
  weight?: number;
  class?: string;
  id?: string;
}

const {
  label,
  labelled = true,
  country = ispm15.countryCode,
  number = ispm15.registrationNumber,
  // TODO[UNBESTÄTIGT] Behandlungscode — kënnt aus `src/data/company.ts`,
  // Standardwäert "HT", bis Kasel de richtege Code nennt.
  treatmentCode = ispm15.treatmentCode,
  weight = 3,
  class: className = '',
  id,
} = Astro.props;

const uid = id ?? `ippc-${Math.random().toString(36).slice(2, 8)}`;

/* ── D'Ähre ────────────────────────────────────────────────────────────────
   Ee Kär gëtt eemol als Lens definéiert an duerno gedréint a skaléiert.
   Sechs Puer, no uewen ëmmer méi kleng, plus ee Kär op der Spëtzt. */
const GRAIN = 'M0 0C10 -6 24 -5 31 0C24 5 10 6 0 0Z';
const pairs = [
  { y: 40, s: 1.0, a: 46 },
  { y: 25, s: 0.94, a: 44 },
  { y: 10, s: 0.87, a: 42 },
  { y: -5, s: 0.79, a: 40 },
  { y: -20, s: 0.69, a: 38 },
  { y: -34, s: 0.57, a: 36 },
];
---

<svg
  viewBox="0 0 360 200"
  class={className}
  role="img"
  aria-labelledby={labelled ? `${uid}-t` : undefined}
  aria-hidden={labelled ? undefined : 'true'}
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  {labelled && <title id={`${uid}-t`}>{label}</title>}

  <!-- Rummen -->
  <rect
    x={weight / 2 + 1}
    y={weight / 2 + 1}
    width={358 - weight}
    height={198 - weight}
    rx="10"
    fill="none"
    stroke="currentColor"
    stroke-width={weight}
  />
  <!-- Trennstréch tëschent Symbol a Schrëft -->
  <line x1="122" y1={weight + 2} x2="122" y2={198 - weight} stroke="currentColor" stroke-width={weight} />

  <!-- IPPC-Symbol: styliséiert Weessähre -->
  <g transform="translate(64 100)" fill="currentColor">
    <!-- Halm -->
    <path
      d="M0 74C-3 50 -3 20 0 -34"
      fill="none"
      stroke="currentColor"
      stroke-width={weight + 1}
      stroke-linecap="round"
    />
    <!-- Kären, pueweis lénks a riets -->
    {pairs.map((p) => (
      <>
        <path d={GRAIN} transform={`translate(2 ${p.y}) rotate(${-p.a}) scale(${p.s})`} />
        <path d={GRAIN} transform={`translate(-2 ${p.y}) rotate(${180 + p.a}) scale(${p.s})`} />
      </>
    ))}
    <!-- Spëtzt -->
    <path d={GRAIN} transform="translate(0 -36) rotate(-90) scale(0.62)" />
    <!-- Grannen -->
    <path
      d="M0 -52C-6 -62 -9 -70 -9 -78M0 -52C6 -62 9 -70 9 -78M0 -54V-80"
      fill="none"
      stroke="currentColor"
      stroke-width={weight - 0.6}
      stroke-linecap="round"
    />
  </g>

  <!-- Länercode, Registréierungsnummer, Behandlungscode -->
  <g
    fill="currentColor"
    text-anchor="middle"
    font-family="Archivo, Helvetica Neue, Arial, sans-serif"
    font-weight="700"
    style="font-stretch:100%;font-variant-numeric:tabular-nums"
  >
    <text x="240" y="86" font-size="44">{country} – {number}</text>
    <text x="240" y="158" font-size="52">{treatmentCode}</text>
  </g>
</svg>
