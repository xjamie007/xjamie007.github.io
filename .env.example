# ---------------------------------------------------------------------------
# Kopéier dës Datei op `.env` a fëll se aus. `.env` kënnt NI an d'Repository.
# ---------------------------------------------------------------------------

# Endpunkt vun der Supabase Edge Function, déi d'Ufro entgéinthëlt.
# Dat ass déi eenzeg Adress, déi am Frontend stoe muss.
PUBLIC_INQUIRY_ENDPOINT="https://<projet-ref>.supabase.co/functions/v1/send-inquiry"

# ---- Nëmme Server-Säit (Supabase Edge Function Secrets, NET am Frontend) ----
# `supabase secrets set --env-file ./supabase/.env`
INQUIRY_TO="tom@kasel.lu"
INQUIRY_FROM="ufro@kasel.lu"
RESEND_API_KEY=""
ALLOWED_ORIGIN="https://www.kasel.lu"
